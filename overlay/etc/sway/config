# VaultOS Sway Configuration
# Immutable and locked down for user safety

# Modifier key: Super (Windows key)
set $mod Mod4

# Font for window titles and bar
font pango:DejaVu Sans Mono 10

# Wallpaper and background
output * bg #181926 solid_color

# Default gap and border style
default_border pixel 2
default_floating_border normal
gaps inner 6
gaps outer 4

# Colors
client.focused          #89b4fa #1e1e2e #cdd6f4 #89b4fa #89b4fa
client.focused_inactive #45475a #181825 #a6adc8 #45475a #45475a
client.unfocused        #313244 #11111b #6c7086 #313244 #313244
client.urgent           #f38ba8 #11111b #f38ba8 #f38ba8 #f38ba8

### Input configuration
input "type:keyboard" {
    xkb_layout "us"
}

input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
}

### Keybindings

# Applications
bindsym $mod+i exec /usr/local/bin/vault-installer-launch.sh
bindsym $mod+f exec firefox
bindsym $mod+e exec pcmanfm
bindsym $mod+t exec foot -T "Debian Sandbox Terminal" /usr/local/bin/vault-sandbox-terminal.sh
bindsym $mod+x exec /usr/local/bin/vault-power.sh

# Window management
bindsym $mod+q kill
bindsym $mod+Shift+q kill
bindsym $mod+space floating toggle

# Focus movement
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Fullscreen toggle
bindsym $mod+Shift+f fullscreen toggle

# Reload configuration
bindsym $mod+Shift+r reload

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

# Window rules
for_window [app_id="firefox"] border pixel 2
for_window [app_id="pcmanfm"] border pixel 2
for_window [title="Debian Sandbox Terminal"] border pixel 2
for_window [title="VaultOS Power Menu"] floating enable
for_window [app_id="vault-installer"] floating enable
for_window [title="VaultOS Installer"] floating enable

# Autostart status bar and core services
bar {
    swaybar_command waybar
}
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Auto-launch installer on startup
exec /usr/local/bin/vault-installer-launch.sh
